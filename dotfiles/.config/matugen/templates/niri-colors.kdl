layout{
    focus-ring{
        active-gradient from="{{colors.tertiary.default.hex}}E6" to="{{colors.primary.default.hex}}E6" angle=135
        urgent-color "{{colors.error.default.hex}}"

        }
}
recent-windows {
    highlight {
        active-color "{{colors.surface_bright.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
}
// 内置screencast portal选择器的配色
screen-cast-picker {
    background-color "{{colors.surface_container.default.hex}}"
    accent-color "{{colors.primary.default.hex}}"
    text-color "{{colors.on_surface.default.hex}}"
    accent-text-color "{{colors.on_primary.default.hex}}"
}
grid-overview {
    minimized-highlight {
        // off
        color "{{colors.secondary.default.hex}}80"
        urgent-color "{{colors.primary.default.hex}}80"
    }
}
