# ── 配置 ──────────────────────────────────────────────────────────────

APP_NAME = "wordlens"
CONFIG_DIR = os.path.expanduser("~/.config/wordlens")
CONFIG_FILE = os.environ.get("WORDLENS_CONFIG", os.path.join(CONFIG_DIR, "state.json"))
CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "wordlens"
)
SCHEDULER_CACHE = os.environ.get(
    "WORDLENS_SCHEDULER_CACHE", os.path.join(CACHE_DIR, "scheduler.json")
)

DEFAULT_SYSTEM_PROMPT = """\
你是一个翻译助手，截图图片背景、上下文，将各种语言翻译为中文。
- 尊重原文，做到信达雅翻译
- 在翻译之后可以给出重点单词的音标和简短解释
- 不要输出任何额外解释、寒暄或无关内容
- 输出格式使用 Markdown，适合在小窗口中阅读"""

DEFAULT_STATE = {
    "active_profile": "opencodezen",
    "active_models": [
        {"profile_id": "opencodezen", "model": "mimo-v2.5-free"},
    ],
    "profiles": {
        "opencodezen": {
            "name": "opencodezen",
            "api_url": "https://opencode.ai/zen/v1/chat/completions",
            "api_key": "public",
            "model": "mimo-v2.5-free",
            "multimodal": True,
        },
        "openrouter": {
            "name": "OpenRouter",
            "api_url": "https://openrouter.ai/api/v1/chat/completions",
            "api_key": "",
            "model": "",
            "multimodal": True,
        },
        "ollama": {
            "name": "Ollama",
            "api_url": "http://localhost:11434/v1/chat/completions",
            "api_key": "ollama",
            "model": "",
            "multimodal": True,
        },
    },
    "settings": {
        "system_prompt": DEFAULT_SYSTEM_PROMPT,
        "user_prompt": "解释一下",
        "temperature": 0.3,
        "reasoning_effort": "none",
    },
}


def _deep_merge(default, data):
    if not isinstance(data, dict):
        return default.copy()
    merged = default.copy()
    for key, value in data.items():
        if isinstance(value, dict) and isinstance(merged.get(key), dict):
            merged[key] = _deep_merge(merged[key], value)
        else:
            merged[key] = value
    return merged


def load_state():
    if not os.path.exists(CONFIG_FILE):
        state = json.loads(json.dumps(DEFAULT_STATE, ensure_ascii=False))
        save_state(state)
        return state
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception:
        state = json.loads(json.dumps(DEFAULT_STATE, ensure_ascii=False))
        normalize_state(state)
        return state
    state = _deep_merge(DEFAULT_STATE, data)
    if "active_models" not in data:
        state.pop("active_models", None)
    normalize_state(state)
    return state


def normalize_state(state):
    profiles = state.setdefault("profiles", {})
    xiaomi = profiles.get("xiaomi", {})
    if (
        xiaomi.get("name") == "Xiaomi MiMo"
        and xiaomi.get("api_url") == "https://token-plan-sgp.xiaomimimo.com/v1/chat/completions"
        and not str(xiaomi.get("api_key", "")).strip()
        and xiaomi.get("model") == "mimo-v2.5"
    ):
        profiles.pop("xiaomi")
    for profile in profiles.values():
        model = str(profile.get("model", "")).strip()
        models = profile.get("models")
        if not isinstance(models, list):
            models = [model] if model else []
        profile["models"] = list(dict.fromkeys(
            str(item).strip() for item in models if str(item).strip()
        ))
        if model and model not in profile["models"]:
            profile["models"].append(model)

    if state.get("active_profile") not in profiles:
        state["active_profile"] = "opencodezen" if "opencodezen" in profiles else next(iter(profiles), "")

    if not isinstance(state.get("active_models"), list):
        active = state.get("active_profile", "")
        model = profiles.get(active, {}).get("model", "")
        state["active_models"] = (
            [{"profile_id": active, "model": model}] if active and model else []
        )

    valid = []
    seen = set()
    for item in state.get("active_models", []):
        if not isinstance(item, dict):
            continue
        profile_id = str(item.get("profile_id", "")).strip()
        model = str(item.get("model", "")).strip()
        if profile_id not in profiles or not model or (profile_id, model) in seen:
            continue
        if model not in profiles[profile_id]["models"]:
            profiles[profile_id]["models"].append(model)
        seen.add((profile_id, model))
        valid.append({"profile_id": profile_id, "model": model})
    state["active_models"] = valid


def save_state(state):
    normalize_state(state)
    config_parent = os.path.dirname(CONFIG_FILE)
    if config_parent:
        os.makedirs(config_parent, exist_ok=True)
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        json.dump(state, f, ensure_ascii=False, indent=4)


def get_active_profile(state):
    profiles = state.get("profiles", {})
    active = state.get("active_profile", "opencodezen")
    profile = profiles.get(active) or profiles.get("opencodezen")
    if not profile:
        raise RuntimeError("没有可用 Provider，请运行 wl-wordlens config 配置")
    return active, profile


def split_api_keys(raw):
    return [
        item.strip()
        for line in str(raw or "").splitlines()
        for item in line.split(",")
        if item.strip()
    ]


def resolved_api_keys(profile_id, profile):
    keys = []
    for item in split_api_keys(profile.get("api_key", "")):
        if item.startswith("$env:"):
            keys.extend(split_api_keys(os.environ.get(item[5:], "")))
        else:
            keys.append(item)
    if not keys and profile_id == "opencodezen":
        keys = ["public"]
    return keys


def active_endpoints(state):
    profiles = state.get("profiles", {})
    endpoints = []
    for active in state.get("active_models", []):
        profile_id = active.get("profile_id", "")
        model = active.get("model", "")
        profile = profiles.get(profile_id)
        if not profile:
            continue
        for key_index, api_key in enumerate(resolved_api_keys(profile_id, profile)):
            endpoints.append({
                "id": f"{profile_id}\t{model}\t{key_index}",
                "profile_id": profile_id,
                "profile": profile,
                "model": model,
                "api_key": api_key,
                "key_index": key_index,
            })
    if not endpoints:
        active, profile = get_active_profile(state)
        model = profile.get("model", "")
        for key_index, api_key in enumerate(resolved_api_keys(active, profile)):
            endpoints.append({
                "id": f"{active}\t{model}\t{key_index}",
                "profile_id": active,
                "profile": profile,
                "model": model,
                "api_key": api_key,
                "key_index": key_index,
            })
    return endpoints


def _with_scheduler_cache(update):
    cache_parent = os.path.dirname(SCHEDULER_CACHE)
    if cache_parent:
        os.makedirs(cache_parent, exist_ok=True)
    lock_path = SCHEDULER_CACHE + ".lock"
    with open(lock_path, "a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            with open(SCHEDULER_CACHE, "r", encoding="utf-8") as cache_file:
                cache = json.load(cache_file)
        except (OSError, ValueError):
            cache = {}
        if not isinstance(cache, dict):
            cache = {}
        result = update(cache)
        tmp_path = SCHEDULER_CACHE + f".{os.getpid()}.tmp"
        try:
            with open(tmp_path, "w", encoding="utf-8") as cache_file:
                json.dump(cache, cache_file, ensure_ascii=False, indent=2)
            os.replace(tmp_path, SCHEDULER_CACHE)
        finally:
            try:
                os.remove(tmp_path)
            except OSError:
                pass
        return result


def ordered_endpoints(endpoints):
    if not endpoints:
        return []

    def update(cache):
        now = time.time()
        cooldowns = {
            endpoint_id: until
            for endpoint_id, until in cache.get("cooldowns", {}).items()
            if isinstance(until, (int, float)) and until > now
        }
        cache["cooldowns"] = cooldowns
        available = [
            index for index, endpoint in enumerate(endpoints)
            if endpoint["id"] not in cooldowns
        ] or list(range(len(endpoints)))
        try:
            cursor = int(cache.get("cursor", 0))
        except (TypeError, ValueError):
            cursor = 0
        start = cursor % len(available)
        cache["cursor"] = cursor + 1
        return available[start:] + available[:start]

    try:
        indices = _with_scheduler_cache(update)
    except OSError:
        indices = list(range(len(endpoints)))
    return [endpoints[index] for index in indices]


def mark_endpoint_failure(endpoint, status=None, error=""):
    text = str(error).lower()
    if status in (401, 403, 429) or any(
        token in text
        for token in ("rate limit", "ratelimit", "quota", "unauthorized", "forbidden", "invalid api key")
    ):
        duration = 600
    elif (
        status == 408
        or status is not None and 500 <= status <= 599
        or any(token in text for token in ("timed out", "timeout", "connection", "request failed"))
    ):
        duration = 120
    else:
        return

    def update(cache):
        cache.setdefault("cooldowns", {})[endpoint["id"]] = time.time() + duration

    try:
        _with_scheduler_cache(update)
    except OSError:
        pass


def mark_endpoint_success(endpoint):
    def update(cache):
        cache.setdefault("cooldowns", {}).pop(endpoint["id"], None)

    try:
        _with_scheduler_cache(update)
    except OSError:
        pass


# ── Provider / 模型查询 ───────────────────────────────────────────────

def normalize_api_url(url):
    url = url.strip().rstrip("/")
    if not url:
        return url
    lower = url.lower()
    if "anthropic" in lower or "claude" in lower:
        if lower.endswith("/models"):
            url = url[:-7]
        if not lower.endswith("/messages"):
            return url + "/messages" if lower.endswith("/v1") else url + "/v1/messages"
        return url
    if "11434" in lower:
        if lower.endswith("/api/tags"):
            url = url[:-9]
        elif lower.endswith("/v1/models"):
            url = url[:-10]
        elif lower.endswith("/models"):
            url = url[:-7]
        lower = url.lower()
        if lower.endswith("/chat/completions") or lower.endswith("/api/chat"):
            return url
        if lower.endswith("/v1"):
            return url + "/chat/completions"
        if lower.endswith("/api"):
            return url + "/chat"
        return url + "/v1/chat/completions"
    if "generativelanguage" in lower:
        return url
    if not lower.endswith("/chat/completions"):
        if lower.endswith("/models"):
            url = url[:-7]
        lower = url.lower()
        return url + "/chat/completions" if lower.endswith("/v1") else url + "/v1/chat/completions"
    return url


def parse_models(data):
    if isinstance(data, dict):
        if isinstance(data.get("data"), list):
            return [m.get("id") or m.get("name") or "" for m in data["data"] if isinstance(m, dict)]
        if isinstance(data.get("models"), list):
            return [(m.get("name", "").replace("models/", "") or m.get("id", "")) for m in data["models"] if isinstance(m, dict)]
    if isinstance(data, list):
        return [(m.get("id") or m.get("name") or str(m)) if isinstance(m, dict) else str(m) for m in data]
    return []


def fetch_models(api_url, api_key):
    url = api_url.strip()
    lower = url.lower()
    is_anthropic = "anthropic" in lower or lower.endswith("/messages")
    if "11434" in lower:
        url = url.split("/v1/")[0].split("/api/")[0] + "/api/tags"
    elif "generativelanguage.googleapis.com" in lower:
        url = "https://generativelanguage.googleapis.com/v1beta/models"
        if api_key:
            url += f"?key={api_key}"
    elif is_anthropic:
        url = url.replace("/messages", "/models")
    else:
        url = url.replace("/openai/chat/completions", "/models")
        url = url.replace("/chat/completions", "/models")
        if not url.endswith("/models"):
            url = url.rstrip("/") + "/models"

    headers = {"User-Agent": "wl-wordlens", "Accept": "application/json"}
    if api_key and "generativelanguage" not in url:
        if is_anthropic:
            headers["x-api-key"] = api_key
            headers["anthropic-version"] = "2023-06-01"
        else:
            headers["Authorization"] = f"Bearer {api_key}"
            headers["x-api-key"] = api_key
    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=8) as resp:
            models = [m for m in parse_models(json.loads(resp.read().decode("utf-8"))) if m]
            return sorted(set(models), key=str.lower), None
    except Exception as e:
        return [], str(e)


# ── 截图 ──────────────────────────────────────────────────────────────

def slurp_geometry():
    """调用 slurp 让用户选区，返回 (x, y, w, h) 或 None（用户取消）。"""
    try:
        result = subprocess.run(
            ["slurp", "-f", "%x,%y,%w,%h"],
            capture_output=True,
            text=True,
            timeout=60,
        )
    except subprocess.TimeoutExpired:
        return None
    if result.returncode != 0:
        return None
    parts = result.stdout.strip().split(",")
    if len(parts) != 4:
        return None
    try:
        return tuple(int(p) for p in parts)
    except ValueError:
        return None


def grim_capture(geometry):
    """用 grim 截取指定区域，返回 PNG bytes。"""
    x, y, w, h = geometry
    result = subprocess.run(
        ["grim", "-g", f"{x},{y} {w}x{h}", "-t", "png", "-"],
        capture_output=True,
        timeout=10,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.decode())
    return result.stdout


# ── 流式 API 调用 ─────────────────────────────────────────────────────

def stream_vision(image_b64, state, on_content, on_done, on_error):
    """后台线程：流式调用 API，通过回调更新 UI。"""
    errors = []
    endpoints = active_endpoints(state)
    if not endpoints:
        GLib.idle_add(on_error, "没有可用 Provider/模型/API Key，请运行 wl-wordlens config 配置")
        return
    for endpoint in ordered_endpoints(endpoints):
        try:
            profile = endpoint["profile"]
            settings = state.get("settings", {})
            api_url = profile.get("api_url", "")
            api_key = endpoint["api_key"]
            model = endpoint["model"]
            if not api_url or not model:
                raise RuntimeError("Provider 缺少 API URL 或模型")

            headers = {"Content-Type": "application/json"}
            if api_key:
                headers["Authorization"] = f"Bearer {api_key}"
                headers["x-api-key"] = api_key

            payload = {
                "model": model,
                "messages": [
                    {"role": "system", "content": settings.get("system_prompt", DEFAULT_SYSTEM_PROMPT)},
                    {"role": "user", "content": [
                        {"type": "text", "text": settings.get("user_prompt", "解释一下")},
                        {"type": "image_url", "image_url": {"url": f"data:image/png;base64,{image_b64}"}},
                    ]},
                ],
                "temperature": float(settings.get("temperature", 0.3)),
                "stream": True,
                "reasoning_effort": settings.get("reasoning_effort", "none"),
            }

            resp = requests.post(api_url, headers=headers, json=payload, stream=True, timeout=60)
            if not resp.ok:
                mark_endpoint_failure(endpoint, resp.status_code, resp.text)
                resp.raise_for_status()

            for line in resp.iter_lines():
                if not line:
                    continue
                line = line.decode("utf-8", errors="replace")
                if not line.startswith("data: "):
                    continue
                data = line[6:]
                if data.strip() == "[DONE]":
                    break
                try:
                    chunk = json.loads(data)
                except json.JSONDecodeError:
                    continue
                choices = chunk.get("choices", [])
                if not choices:
                    continue
                delta = choices[0].get("delta", {})
                content = delta.get("content")
                if content:
                    GLib.idle_add(on_content, content)

            mark_endpoint_success(endpoint)
            GLib.idle_add(on_done)
            return
        except Exception as e:
            mark_endpoint_failure(endpoint, error=str(e))
            errors.append(
                f"{endpoint['profile_id']} / {endpoint['model']} key#{endpoint['key_index'] + 1}: {e}"
            )
    GLib.idle_add(on_error, "所有模型端点均失败：\n" + "\n".join(errors))


# ── Markdown → Pango markup ──────────────────────────────────────────

_md = MarkdownIt("commonmark", {"html": False}).enable("strikethrough")
_HEADING_SIZES = {1: "xx-large", 2: "x-large", 3: "large", 4: "large", 5: "medium", 6: "medium"}


def _escape(text):
    return html.escape(text, quote=False)


def _render_inline(tokens):
    parts = []
    for tok in tokens:
        t = tok.type
        if t == "text":
            parts.append(_escape(tok.content))
        elif t == "strong_open":
            parts.append("<b>")
        elif t == "strong_close":
            parts.append("</b>")
        elif t == "em_open":
            parts.append("<i>")
        elif t == "em_close":
            parts.append("</i>")
        elif t == "s_open":
            parts.append("<s>")
        elif t == "s_close":
            parts.append("</s>")
        elif t == "code_inline":
            parts.append(f'<span background="#333333" foreground="#e0e0e0" font_family="monospace"> {_escape(tok.content)} </span>')
        elif t in ("softbreak", "hardbreak"):
            parts.append("\n")
        elif t == "image":
            alt = "".join(c.content for c in (tok.children or []))
            parts.append(_escape(f"[{alt}]"))
        else:
            parts.append(_escape(tok.content))
    return "".join(parts)


def markdown_to_pango(md_text):
    tokens = _md.parse(md_text)
    lines = []
    i = 0
    list_depth = 0

    while i < len(tokens):
        tok = tokens[i]
        t = tok.type
        if t == "heading_open":
            level = int(tok.tag[1])
            size = _HEADING_SIZES.get(level, "medium")
            i += 1
            inline = tokens[i]
            i += 2
            lines.append(f'<span size="{size}" weight="bold">{_render_inline(inline.children)}</span>')
            lines.append("")
            continue
        if t == "paragraph_open":
            i += 1
            inline = tokens[i]
            i += 2
            lines.append(_render_inline(inline.children))
            lines.append("")
            continue
        if t in ("bullet_list_open", "ordered_list_open"):
            list_depth += 1
            i += 1
            continue
        if t in ("bullet_list_close", "ordered_list_close"):
            list_depth -= 1
            if list_depth == 0:
                lines.append("")
            i += 1
            continue
        if t == "list_item_open":
            i += 1
            item_parts = []
            while i < len(tokens) and tokens[i].type != "list_item_close":
                if tokens[i].type == "paragraph_open":
                    i += 1
                    item_parts.append(_render_inline(tokens[i].children))
                    i += 2
                elif tokens[i].type in ("bullet_list_open", "ordered_list_open"):
                    nested = 1
                    i += 1
                    while i < len(tokens) and nested > 0:
                        nt = tokens[i].type
                        if nt in ("bullet_list_open", "ordered_list_open"):
                            nested += 1
                        elif nt in ("bullet_list_close", "ordered_list_close"):
                            nested -= 1
                        elif nt == "paragraph_open":
                            i += 1
                            item_parts.append("  • " + _render_inline(tokens[i].children))
                            i += 2
                            continue
                        i += 1
                else:
                    i += 1
            i += 1
            indent = "  " * (list_depth - 1)
            bullet = "•" if tok.markup in ("*", "-", "+") else "◦"
            lines.append(f"{indent}{bullet} {' '.join(item_parts)}")
            continue
        if t in ("code_block", "fence"):
            code = _escape(tok.content.rstrip("\n"))
            for cl in code.split("\n"):
                lines.append(f'<span font_family="monospace" foreground="#cfd8dc">{cl}</span>')
            lines.append("")
            i += 1
            continue
        if t == "hr":
            lines.append("─────────────")
            lines.append("")
            i += 1
            continue
        if t == "blockquote_open":
            depth_bq = 1
            i += 1
            while i < len(tokens) and depth_bq > 0:
                nt = tokens[i].type
                if nt == "blockquote_open":
                    depth_bq += 1
                elif nt == "blockquote_close":
                    depth_bq -= 1
                elif nt == "paragraph_open":
                    i += 1
                    lines.append(f'<i>  {_render_inline(tokens[i].children)}</i>')
                    i += 2
                    continue
                i += 1
            lines.append("")
            continue
        i += 1

    return "\n".join(lines).rstrip()


# ── GTK 窗口 ──────────────────────────────────────────────────────────

CSS = b"""
.wordlens-content {
    padding: 10px 12px;
    font-size: 12pt;
}
.wordlens-content label {
    line-height: 1.4;
}
.wordlens-status {
    opacity: 0.5;
}
"""

WIN_WIDTH = 420
WIN_HEIGHT = 400


class WordlensWindow(Gtk.Application):
    def __init__(self, image_b64, state):
        super().__init__(application_id="com.wordlens.app", flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.image_b64 = image_b64
        self.state = state
        self.content_text = ""
        self.got_content = False
        self.connect("activate", self.on_activate)

    def on_activate(self, app):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        win = Gtk.ApplicationWindow(application=app)
        win.set_default_size(WIN_WIDTH, WIN_HEIGHT)
        win.set_title("wl-wordlens")

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.content_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.content_box.add_css_class("wordlens-content")
        self.content_box.set_vexpand(True)

        self.content_label = Gtk.Label(label="")
        self.content_label.set_halign(Gtk.Align.START)
        self.content_label.set_valign(Gtk.Align.START)
        self.content_label.set_wrap(True)
        self.content_label.set_xalign(0.0)
        self.content_label.set_visible(False)
        self.content_box.append(self.content_label)

        self.status_label = Gtk.Label(label="识别中...")
        self.status_label.add_css_class("wordlens-status")
        self.status_label.set_halign(Gtk.Align.START)
        self.content_box.append(self.status_label)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_child(self.content_box)
        scrolled.set_vexpand(True)
        main_box.append(scrolled)

        win.set_child(main_box)
        self.win = win
        win.present()

        key_controller = Gtk.EventControllerKey()
        key_controller.connect("key-pressed", self.on_key_pressed)
        win.add_controller(key_controller)

        threading.Thread(
            target=stream_vision,
            args=(self.image_b64, self.state, self.on_content, self.on_done, self.on_error),
            daemon=True,
        ).start()

    def on_key_pressed(self, controller, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            self.win.close()
            return True
        return False

    def on_content(self, text):
        if not self.got_content:
            self.got_content = True
            self.status_label.set_visible(False)
        self.content_text += text
        try:
            self.content_label.set_markup(markdown_to_pango(self.content_text))
        except Exception:
            self.content_label.set_label(self.content_text)
        self.content_label.set_visible(True)

    def on_done(self):
        if not self.got_content:
            self.status_label.set_label("（未返回内容）")

    def on_error(self, msg):
        self.status_label.set_visible(False)
        self.content_label.set_label(f"错误: {msg}")
        self.content_label.set_visible(True)


# ── 简单 TUI ──────────────────────────────────────────────────────────

locale.setlocale(locale.LC_ALL, "")
C_MAIN, C_HL, C_TITLE, C_ERR, C_OK = 1, 2, 3, 4, 5


def str_width(s):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in str(s))


def pad_str(s, width):
    return str(s) + " " * max(0, width - str_width(s))


def truncate_str(s, max_width):
    width = 0
    out = []
    for ch in str(s):
        ch_width = 2 if unicodedata.east_asian_width(ch) in "WF" else 1
        if width + ch_width > max_width:
            break
        out.append(ch)
        width += ch_width
    return "".join(out)


def safe_addstr(win, y, x, text, attr=0):
    try:
        win.addstr(y, x, text, attr)
    except curses.error:
        pass


def init_colors():
    curses.start_color()
    curses.use_default_colors()
    curses.init_pair(C_MAIN, curses.COLOR_WHITE, -1)
    curses.init_pair(C_HL, curses.COLOR_BLACK, curses.COLOR_CYAN)
    curses.init_pair(C_TITLE, curses.COLOR_CYAN, -1)
    curses.init_pair(C_ERR, curses.COLOR_RED, -1)
    curses.init_pair(C_OK, curses.COLOR_GREEN, -1)


def draw_box(stdscr, y, x, h, w, title=""):
    attr = curses.color_pair(C_TITLE)
    safe_addstr(stdscr, y, x, "┌" + "─" * (w - 2) + "┐", attr)
    for row in range(1, h - 1):
        safe_addstr(stdscr, y + row, x, "│" + " " * (w - 2) + "│", attr)
    safe_addstr(stdscr, y + h - 1, x, "└" + "─" * (w - 2) + "┘", attr)
    if title:
        safe_addstr(stdscr, y, x + 2, f" {title} ", attr | curses.A_BOLD)


def menu_dialog(stdscr, title, options, default_idx=0, hint="[Enter]选择 [q]返回", allow_search=False):
    sel = default_idx
    filter_mode = False
    filter_str = ""
    while True:
        sh, sw = stdscr.getmaxyx()
        filtered = [o for o in options if not filter_str or filter_str.lower() in o[0].lower()]
        sel = max(0, min(sel, max(0, len(filtered) - 1)))
        h = max(8, min(sh - 2, len(filtered) + 5))
        w = min(sw - 2, max(52, max((str_width(o[0]) for o in options), default=0) + 8))
        y, x = (sh - h) // 2, (sw - w) // 2

        stdscr.erase()
        draw_box(stdscr, y, x, h, w, title)
        footer = f" 搜索: {filter_str}_ " if filter_mode else f" {hint}{' [/]搜索' if allow_search else ''} "
        safe_addstr(stdscr, y + h - 1, x + 2, truncate_str(footer, w - 4), curses.color_pair(C_TITLE) | (curses.A_BOLD if filter_mode else 0))
        list_h = h - 4
        start = max(0, min(sel - list_h // 2, max(0, len(filtered) - list_h)))
        if not filtered:
            safe_addstr(stdscr, y + 2, x + 2, "无匹配项", curses.color_pair(C_MAIN))
        for i in range(list_h):
            idx = start + i
            if idx >= len(filtered):
                break
            text = truncate_str(filtered[idx][0], w - 5)
            attr = curses.color_pair(C_HL) if idx == sel else curses.color_pair(C_MAIN)
            safe_addstr(stdscr, y + 2 + i, x + 2, pad_str(text, w - 4), attr)
        stdscr.refresh()

        try:
            key = stdscr.get_wch()
        except curses.error:
            continue
        code, char = (key, "") if isinstance(key, int) else (ord(key), key)
        if filter_mode:
            if code in (27,):
                filter_mode = False
                filter_str = ""
            elif code in (10, 13):
                filter_mode = False
            elif code in (curses.KEY_BACKSPACE, 127, 8):
                filter_str = filter_str[:-1]
            elif char.isprintable():
                filter_str += char
            continue
        if code in (27, ord("q"), ord("Q")):
            return None
        if code in (curses.KEY_UP, ord("k")):
            sel = max(0, sel - 1)
        elif code in (curses.KEY_DOWN, ord("j")):
            sel = min(len(filtered) - 1, sel + 1)
        elif code == ord("/") and allow_search:
            filter_mode = True
            filter_str = ""
        elif code in (10, 13) and filtered:
            return filtered[sel][1]


def input_dialog(stdscr, title, fields):
    values = [str(f.get("value", "")) for f in fields]
    cursors = [len(v) for v in values]
    sel = 0
    editing = False
    while True:
        sh, sw = stdscr.getmaxyx()
        h = min(sh - 2, len(fields) + 8)
        w = min(sw - 2, 90)
        y, x = (sh - h) // 2, (sw - w) // 2
        stdscr.erase()
        draw_box(stdscr, y, x, h, w, title)
        for i, field in enumerate(fields):
            fy = y + 3 + i
            label = field.get("label", "")
            safe_addstr(stdscr, fy, x + 2, label, curses.color_pair(C_TITLE))
            field_x = x + 18
            field_w = w - 21
            if field.get("textarea"):
                count = len(split_api_keys(values[i]))
                vis = f"{count} 个 Key (Enter 打开 $EDITOR)"
            else:
                vis = values[i]
            if len(vis) > field_w - 1:
                vis = vis[max(0, cursors[i] - field_w + 2):]
            attr = curses.A_UNDERLINE | (curses.color_pair(C_HL) if sel == i and not editing else curses.color_pair(C_MAIN))
            safe_addstr(stdscr, fy, field_x, pad_str(truncate_str(vis, field_w), field_w), attr)
        by = y + h - 3
        save_attr = curses.color_pair(C_HL) if sel == len(fields) else curses.color_pair(C_MAIN)
        cancel_attr = curses.color_pair(C_HL) if sel == len(fields) + 1 else curses.color_pair(C_MAIN)
        safe_addstr(stdscr, by, x + 8, "[ 保存 ]", save_attr)
        safe_addstr(stdscr, by, x + 20, "[ 取消 ]", cancel_attr)
        safe_addstr(stdscr, y + h - 1, x + 2, " [j/k]选择 [Enter/i]编辑/确认 [q/Esc]取消 ", curses.color_pair(C_TITLE))
        stdscr.refresh()

        try:
            key = stdscr.get_wch()
        except curses.error:
            continue
        code, char = (key, "") if isinstance(key, int) else (ord(key), key)
        if editing and sel < len(fields):
            if code in (27, 10, 13):
                editing = False
            elif code == curses.KEY_LEFT:
                cursors[sel] = max(0, cursors[sel] - 1)
            elif code == curses.KEY_RIGHT:
                cursors[sel] = min(len(values[sel]), cursors[sel] + 1)
            elif code in (curses.KEY_BACKSPACE, 127, 8):
                c = cursors[sel]
                if c > 0:
                    values[sel] = values[sel][:c - 1] + values[sel][c:]
                    cursors[sel] -= 1
            elif code == curses.KEY_DC:
                c = cursors[sel]
                if c < len(values[sel]):
                    values[sel] = values[sel][:c] + values[sel][c + 1:]
            elif char.isprintable():
                c = cursors[sel]
                values[sel] = values[sel][:c] + char + values[sel][c:]
                cursors[sel] += 1
            continue
        if code in (27, ord("q"), ord("Q")):
            return None
        if code in (curses.KEY_UP, ord("k")):
            sel = max(0, sel - 1)
        elif code in (curses.KEY_DOWN, ord("j"), 9):
            sel = min(len(fields) + 1, sel + 1)
        elif code in (10, 13, ord("i"), ord("I")):
            if sel == len(fields):
                return values
            if sel == len(fields) + 1:
                return None
            if fields[sel].get("textarea"):
                curses.endwin()
                try:
                    values[sel] = edit_text_external(values[sel])
                    cursors[sel] = len(values[sel])
                finally:
                    stdscr.clear()
                continue
            editing = True


def msgbox(stdscr, title, text):
    lines = text.splitlines() or [""]
    sh, sw = stdscr.getmaxyx()
    h = min(sh - 2, max(7, len(lines) + 5))
    w = min(sw - 2, max(50, max((str_width(l) for l in lines), default=0) + 6))
    y, x = (sh - h) // 2, (sw - w) // 2
    stdscr.erase()
    draw_box(stdscr, y, x, h, w, title)
    for i, line in enumerate(lines[:h - 4]):
        safe_addstr(stdscr, y + 2 + i, x + 2, truncate_str(line, w - 4), curses.color_pair(C_MAIN))
    safe_addstr(stdscr, y + h - 1, x + 2, " [Enter/q]返回 ", curses.color_pair(C_TITLE))
    stdscr.refresh()
    while True:
        key = stdscr.getch()
        if key in (10, 13, 27, ord("q"), ord("Q")):
            return


def edit_text_external(initial_text):
    editor = os.environ.get("EDITOR", "vim")
    with tempfile.NamedTemporaryFile(suffix=".txt", mode="w+", delete=False, encoding="utf-8") as tf:
        tf.write(initial_text)
        path = tf.name
    try:
        subprocess.run([editor, path])
        with open(path, "r", encoding="utf-8") as f:
            return f.read().strip()
    finally:
        try:
            os.remove(path)
        except OSError:
            pass


def configured_model_choices(state):
    choices = []
    for profile_id, profile in state.get("profiles", {}).items():
        for model in profile.get("models", []):
            choices.append((profile_id, profile, model))
    return choices


def is_active_model(state, profile_id, model):
    return any(
        item.get("profile_id") == profile_id and item.get("model") == model
        for item in state.get("active_models", [])
    )


def toggle_active_model(state, profile_id, model):
    active = state.setdefault("active_models", [])
    for index, item in enumerate(active):
        if item.get("profile_id") == profile_id and item.get("model") == model:
            active.pop(index)
            return False
    active.append({"profile_id": profile_id, "model": model})
    state["active_profile"] = profile_id
    state["profiles"][profile_id]["model"] = model
    return True


def select_active_models(stdscr, state):
    choices = configured_model_choices(state)
    if not choices:
        msgbox(stdscr, "没有模型", "请先在“供应商和模型”中用 Tab 勾选模型。")
        return
    sel = next((
        index for index, (pid, _, model) in enumerate(choices)
        if is_active_model(state, pid, model)
    ), 0)
    while True:
        options = []
        for profile_id, profile, model in choices:
            marker = "[*]" if is_active_model(state, profile_id, model) else "[ ]"
            options.append((f"{marker} {profile.get('name', profile_id)} / {model}", (profile_id, model)))

        sh, sw = stdscr.getmaxyx()
        h = max(8, min(sh - 2, len(options) + 5))
        w = min(sw - 2, max(60, max(str_width(item[0]) for item in options) + 6))
        y, x = (sh - h) // 2, (sw - w) // 2
        stdscr.erase()
        draw_box(stdscr, y, x, h, w, "配置多模态模型")
        visible = h - 4
        start = max(0, min(sel - visible + 1, max(0, len(options) - visible)))
        for row, index in enumerate(range(start, min(len(options), start + visible))):
            attr = curses.color_pair(C_HL) if index == sel else curses.color_pair(C_MAIN)
            safe_addstr(stdscr, y + 2 + row, x + 2, pad_str(truncate_str(options[index][0], w - 4), w - 4), attr)
        safe_addstr(stdscr, y + h - 1, x + 2, " [Tab/Space]激活/取消 [Enter/q]确认 ", curses.color_pair(C_TITLE))
        stdscr.refresh()
        key = stdscr.getch()
        if key in (27, ord("q"), ord("Q"), 10, 13):
            return
        if key in (curses.KEY_UP, ord("k")):
            sel = max(0, sel - 1)
        elif key in (curses.KEY_DOWN, ord("j")):
            sel = min(len(options) - 1, sel + 1)
        elif key in (9, ord(" ")):
            profile_id, model = options[sel][1]
            toggle_active_model(state, profile_id, model)


def group_models(models, filter_str=""):
    groups = {"All": []}
    query = filter_str.lower()
    for model in models:
        if query and query not in model.lower():
            continue
        groups["All"].append((model, model))
        if "/" in model:
            org, name = model.split("/", 1)
            groups.setdefault(org, []).append((name, model))
    return groups


def draw_browser_column(stdscr, x, width, height, title, items, selected, active):
    attr = curses.color_pair(C_HL) if active else curses.color_pair(C_TITLE) | curses.A_BOLD
    safe_addstr(stdscr, 0, x, pad_str(truncate_str(f" {title} ", width), width), attr)
    visible = max(1, height - 3)
    start = max(0, min(selected - visible + 1, max(0, len(items) - visible)))
    for row, item in enumerate(items[start:start + visible]):
        index = start + row
        row_attr = curses.color_pair(C_HL) if active and index == selected else curses.color_pair(C_MAIN)
        safe_addstr(stdscr, row + 1, x, pad_str(truncate_str(item, width), width), row_attr)


def provider_model_browser(stdscr, state):
    provider_ids = list(state.get("profiles", {}))
    if not provider_ids:
        add_or_edit_provider(stdscr, state, None)
        provider_ids = list(state.get("profiles", {}))
    col = provider_idx = org_idx = model_idx = 0
    raw_models = []
    groups = {"All": []}
    filter_str = ""
    filter_mode = False
    status = ""
    fetch_queue = queue.Queue()
    fetch_seq = 0
    loading = False

    def refresh():
        nonlocal fetch_seq, loading, status, raw_models, groups, org_idx, model_idx
        if not provider_ids:
            return
        fetch_seq += 1
        seq = fetch_seq
        profile_id = provider_ids[provider_idx]
        profile = state["profiles"][profile_id]
        raw_models = list(profile.get("models", []))
        groups = group_models(raw_models, filter_str)
        org_idx = model_idx = 0
        loading = True
        status = "正在获取模型列表..."

        def worker():
            keys = resolved_api_keys(profile_id, profile)
            models, err = fetch_models(profile.get("api_url", ""), keys[0] if keys else "")
            fetch_queue.put((seq, models, err))

        threading.Thread(target=worker, daemon=True).start()

    refresh()
    stdscr.timeout(100)
    try:
      while True:
        try:
            seq, models, err = fetch_queue.get_nowait()
            if seq == fetch_seq:
                loading = False
                profile_id = provider_ids[provider_idx]
                configured = state["profiles"][profile_id].get("models", [])
                raw_models = list(dict.fromkeys([*models, *configured]))
                groups = group_models(raw_models, filter_str)
                org_idx = model_idx = 0
                status = f"获取模型失败: {err}" if err else f"已获取 {len(models)} 个模型"
        except queue.Empty:
            pass

        profiles = state.get("profiles", {})
        provider_ids = [pid for pid in provider_ids if pid in profiles]
        for pid in profiles:
            if pid not in provider_ids:
                provider_ids.append(pid)
        provider_idx = min(provider_idx, max(0, len(provider_ids) - 1))
        orgs = list(groups) or ["All"]
        org_idx = min(org_idx, len(orgs) - 1)
        models = groups.get(orgs[org_idx], [])
        model_idx = min(model_idx, max(0, len(models) - 1))

        sh, sw = stdscr.getmaxyx()
        left = max(10, sw * 28 // 100)
        mid = max(8, sw * 22 // 100)
        right = max(8, sw - left - mid - 2)
        profile_lines = []
        for pid in provider_ids:
            marker = "* " if any(item.get("profile_id") == pid for item in state.get("active_models", [])) else "  "
            profile_lines.append(marker + profiles[pid].get("name", pid))
        model_lines = []
        if provider_ids:
            profile_id = provider_ids[provider_idx]
            selected_models = profiles[profile_id].get("models", [])
            for name, full in models:
                model_lines.append(f"{'[*]' if full in selected_models else '[ ]'} {name}")

        stdscr.erase()
        draw_browser_column(stdscr, 0, left, sh, "PROVIDERS", profile_lines, provider_idx, col == 0)
        draw_browser_column(stdscr, left + 1, mid, sh, "ORG", orgs, org_idx, col == 1)
        title = f"MODELS /{filter_str}" if filter_str else "MODELS"
        draw_browser_column(stdscr, left + mid + 2, right, sh, title, model_lines, model_idx, col == 2)
        safe_addstr(stdscr, sh - 2, 0, truncate_str(status, sw - 1), curses.color_pair(C_ERR if "失败" in status else C_OK))
        hint = f"搜索: {filter_str}_ [Enter]确认 [Esc]取消" if filter_mode else "[h/l]切栏 [j/k]移动 [Tab]勾选 [Enter]编辑Provider [/]搜索 [r]刷新 [a/d]增删 [q]返回"
        safe_addstr(stdscr, sh - 1, 0, truncate_str(hint, sw - 1), curses.color_pair(C_TITLE))
        stdscr.refresh()

        try:
            key = stdscr.get_wch()
        except curses.error:
            continue
        code, char = (key, "") if isinstance(key, int) else (ord(key), key)
        if filter_mode:
            if code == 27:
                filter_mode = False
                filter_str = ""
            elif code in (10, 13):
                filter_mode = False
            elif code in (curses.KEY_BACKSPACE, 127, 8):
                filter_str = filter_str[:-1]
            elif char.isprintable():
                filter_str += char
            groups = group_models(raw_models, filter_str)
            org_idx = model_idx = 0
            continue
        if code in (27, ord("q"), ord("Q")):
            return
        if code in (curses.KEY_LEFT, ord("h")):
            col = max(0, col - 1)
        elif code in (curses.KEY_RIGHT, ord("l")):
            col = min(2, col + 1)
        elif code in (curses.KEY_UP, ord("k")):
            if col == 0 and provider_idx:
                provider_idx -= 1
                raw_models = []
                groups = {"All": []}
                refresh()
            elif col == 1:
                org_idx = max(0, org_idx - 1)
                model_idx = 0
            elif col == 2:
                model_idx = max(0, model_idx - 1)
        elif code in (curses.KEY_DOWN, ord("j")):
            if col == 0 and provider_idx < len(provider_ids) - 1:
                provider_idx += 1
                raw_models = []
                groups = {"All": []}
                refresh()
            elif col == 1:
                org_idx = min(len(orgs) - 1, org_idx + 1)
                model_idx = 0
            elif col == 2:
                model_idx = min(max(0, len(models) - 1), model_idx + 1)
        elif code == ord("/"):
            filter_mode = True
            filter_str = ""
        elif code == ord("r"):
            refresh()
        elif code == ord("a"):
            new_id = add_or_edit_provider(stdscr, state, None)
            if new_id:
                provider_ids = list(state["profiles"])
                provider_idx = provider_ids.index(new_id)
                refresh()
        elif code == ord("d") and col == 0 and provider_ids:
            pid = provider_ids[provider_idx]
            if pid == "opencodezen":
                msgbox(stdscr, "不可删除", "默认 Provider opencodezen 会作为兜底配置保留。")
            else:
                profiles.pop(pid, None)
                state["active_models"] = [item for item in state.get("active_models", []) if item.get("profile_id") != pid]
                provider_ids.remove(pid)
                if state.get("active_profile") == pid:
                    state["active_profile"] = "opencodezen" if "opencodezen" in profiles else next(iter(profiles), "")
                provider_idx = min(provider_idx, max(0, len(provider_ids) - 1))
                refresh()
        elif code == 9 and col == 2 and models and provider_ids:
            pid = provider_ids[provider_idx]
            model = models[model_idx][1]
            selected_models = profiles[pid].setdefault("models", [])
            if model in selected_models:
                selected_models.remove(model)
                state["active_models"] = [item for item in state.get("active_models", []) if not (item.get("profile_id") == pid and item.get("model") == model)]
                if profiles[pid].get("model") == model:
                    profiles[pid]["model"] = selected_models[0] if selected_models else ""
            else:
                selected_models.append(model)
                if not profiles[pid].get("model"):
                    profiles[pid]["model"] = model
        elif code in (10, 13, ord("i")) and col == 0 and provider_ids:
            old_id = provider_ids[provider_idx]
            new_id = add_or_edit_provider(stdscr, state, old_id)
            if new_id:
                provider_ids = list(state["profiles"])
                provider_idx = provider_ids.index(new_id)
                refresh()
    finally:
        stdscr.timeout(-1)


def select_provider_model(stdscr, state):
    provider_model_browser(stdscr, state)


def add_or_edit_provider(stdscr, state, pid):
    profiles = state.setdefault("profiles", {})
    existing = profiles.get(pid, {}) if pid else {}
    fields = [
        {"label": "ID", "value": pid or ""},
        {"label": "名称", "value": existing.get("name", "")},
        {"label": "API URL", "value": existing.get("api_url", "")},
        {"label": "API Keys", "value": existing.get("api_key", ""), "textarea": True},
        {"label": "模型", "value": existing.get("model", "")},
    ]
    res = input_dialog(stdscr, "编辑 Provider" if pid else "新增 Provider", fields)
    if not res:
        return None
    new_pid = res[0].strip()
    if not re.match(r"^[a-zA-Z_][a-zA-Z0-9_]*$", new_pid):
        msgbox(stdscr, "错误", "ID 只能包含字母、数字、下划线，且不能以数字开头。")
        return None
    if new_pid != pid and new_pid in profiles:
        msgbox(stdscr, "错误", "该 Provider ID 已存在。")
        return None
    if pid and new_pid != pid:
        profiles[new_pid] = profiles.pop(pid)
        if state.get("active_profile") == pid:
            state["active_profile"] = new_pid
        for item in state.get("active_models", []):
            if item.get("profile_id") == pid:
                item["profile_id"] = new_pid
    old_models = existing.get("models", [])
    model = res[4].strip()
    models = list(dict.fromkeys([*old_models, *([model] if model else [])]))
    profiles[new_pid] = {
        "name": res[1].strip() or new_pid,
        "api_url": normalize_api_url(res[2]),
        "api_key": res[3].strip(),
        "model": model,
        "models": models,
        "multimodal": True,
    }
    return new_pid


def edit_settings(stdscr, state):
    settings = state.setdefault("settings", {})
    while True:
        options = [
            ("编辑 System Prompt", "system_prompt"),
            (f"编辑 User Prompt: {settings.get('user_prompt', '解释一下')}", "user_prompt"),
            (f"Temperature: {settings.get('temperature', 0.3)}", "temperature"),
            (f"Reasoning Effort: {settings.get('reasoning_effort', 'none')}", "reasoning_effort"),
            ("返回", "back"),
        ]
        choice = menu_dialog(stdscr, "提示词 / 参数", options)
        if choice in (None, "back"):
            return
        if choice == "system_prompt":
            curses.endwin()
            try:
                settings["system_prompt"] = edit_text_external(settings.get("system_prompt", DEFAULT_SYSTEM_PROMPT))
            finally:
                stdscr.clear()
        elif choice == "user_prompt":
            res = input_dialog(stdscr, "User Prompt", [{"label": "Prompt", "value": settings.get("user_prompt", "解释一下")}])
            if res:
                settings["user_prompt"] = res[0]
        elif choice == "temperature":
            res = input_dialog(stdscr, "Temperature", [{"label": "Value", "value": str(settings.get("temperature", 0.3))}])
            if res:
                try:
                    settings["temperature"] = float(res[0])
                except ValueError:
                    msgbox(stdscr, "错误", "Temperature 必须是数字。")
        elif choice == "reasoning_effort":
            effort = menu_dialog(stdscr, "Reasoning Effort", [(x, x) for x in ("none", "low", "medium", "high")])
            if effort:
                settings["reasoning_effort"] = effort


def run_config_tui(stdscr):
    init_colors()
    curses.curs_set(0)
    state = copy.deepcopy(load_state())
    while True:
        choices = configured_model_choices(state)
        active_count = len(state.get("active_models", []))
        if active_count == 0:
            active_label = "未配置"
        elif active_count == 1:
            item = state["active_models"][0]
            profile = state.get("profiles", {}).get(item.get("profile_id"), {})
            active_label = f"{profile.get('name', item.get('profile_id', ''))} / {item.get('model', '')}"
        else:
            active_label = "Mixed"
        options = [
            (f"配置多模态模型  当前: {active_label}", "active_models"),
            (f"供应商和模型  已勾选: {len(choices)}", "providers"),
            ("编辑提示词 / 参数", "settings"),
            ("状态信息", "status"),
            ("保存并退出", "save"),
            ("放弃修改并退出", "quit"),
        ]
        choice = menu_dialog(stdscr, "wl-wordlens config", options)
        if choice == "active_models":
            select_active_models(stdscr, state)
        elif choice == "providers":
            select_provider_model(stdscr, state)
        elif choice == "settings":
            edit_settings(stdscr, state)
        elif choice == "status":
            active, profile = get_active_profile(state)
            msgbox(stdscr, "状态", format_status(state, active, profile))
        elif choice == "save":
            save_state(state)
            return
        elif choice in (None, "quit"):
            return


# ── CLI ──────────────────────────────────────────────────────────────

def format_status(state, active, profile):
    settings = state.get("settings", {})
    endpoints = active_endpoints(state)
    active_profile_ids = {endpoint["profile_id"] for endpoint in endpoints}
    key_count = sum(
        len(resolved_api_keys(profile_id, state["profiles"][profile_id]))
        for profile_id in active_profile_ids
    )
    return "\n".join([
        f"Active Provider : {active} ({profile.get('name', active)})",
        f"Active Models   : {len(state.get('active_models', []))}",
        f"Endpoints       : {len(endpoints)}",
        f"API Keys        : {key_count}",
        f"API URL         : {profile.get('api_url', '')}",
        f"Config          : {CONFIG_FILE}",
        f"Scheduler Cache : {SCHEDULER_CACHE}",
        f"User Prompt     : {settings.get('user_prompt', '解释一下')}",
        f"Temperature     : {settings.get('temperature', 0.3)}",
        f"Reasoning Effort: {settings.get('reasoning_effort', 'none')}",
    ])


def print_status():
    state = load_state()
    active, profile = get_active_profile(state)
    print(format_status(state, active, profile))


def print_help():
    print("""用法: wl-wordlens [COMMAND]

Commands:
  config, tui   打开配置 TUI
  status        显示当前配置
  help          显示帮助

不带参数运行时启动 Wayland 截图识图翻译。""")


def cli_handler():
    if len(sys.argv) <= 1:
        return False
    cmd = sys.argv[1].lower()
    if cmd in ("-h", "--help", "help"):
        print_help()
        return True
    if cmd in ("status",):
        print_status()
        return True
    if cmd in ("config", "tui"):
        curses.wrapper(run_config_tui)
        return True
    print(f"未知命令: {cmd}\n")
    print_help()
    return True


# ── 主入口 ────────────────────────────────────────────────────────────

def main():
    if cli_handler():
        return

    state = load_state()
    geometry = slurp_geometry()
    if geometry is None:
        sys.exit(0)

    try:
        png_data = grim_capture(geometry)
    except RuntimeError as e:
        print(f"截图失败: {e}", file=sys.stderr)
        sys.exit(1)

    image_b64 = base64.b64encode(png_data).decode()
    app = WordlensWindow(image_b64, state)
    app.run(None)


if __name__ == "__main__":
    main()
